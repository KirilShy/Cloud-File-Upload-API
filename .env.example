# Server
PORT=4001
NODE_ENV=development

# AWS — never commit real values
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_REGION=eu-west-1
AWS_BUCKET_NAME=your-bucket-name

# Signed URL expiry (seconds)
SIGNED_URL_EXPIRES=3600

# File limits
MAX_FILE_SIZE_MB=10

# Database (optional — API works without it)
DATABASE_URL=postgresql://postgres:password@localhost:5433/cloudfiles

# Auth (optional — set to true to require Bearer JWT on all routes)
REQUIRE_AUTH=false
JWT_SECRET=change_me_to_a_long_random_string

# Comma-separated browser origins allowed to call the API
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
